# NutritionLite — variáveis de ambiente. Copie para ".env" e preencha. NUNCA commite o ".env".

# --- Servidor ---
NODE_ENV=development            # em produção: production
PORT=3000
PUBLIC_URL=                     # endereço público (ex.: https://seu-site.com) — usado nas prévias de compartilhamento
APP_URL=                        # link usado nos e-mails (mesmo endereço público)
CORS_ORIGINS=http://localhost:3000

# --- Segurança ---
# Gere com:  npm run segredo   (mínimo 32 caracteres; em produção o servidor NÃO sobe com menos)
JWT_SECRET=

# --- Banco (Azure SQL) ---
DB_SERVER=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_PORT=1433
DB_ENCRYPT=true
DB_TRUST_CERT=false
# Banco serverless dormindo: quanto tentar de novo ao acordar (ms)
DB_RETRY_WINDOW_MS=60000
DB_RETRY_WAIT_MS=5000

# --- IA (Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- E-mail (confirmação de conta e recuperação de senha) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=                     # senha de app (não a senha da conta)
EMAIL_FROM=
# ou, no lugar dos campos acima:  SMTP_URL=smtps://usuario:senha@host:465
# NO RENDER (planos gratuitos) as portas de SMTP são bloqueadas: use uma API de e-mail (porta 443).
# Brevo (grátis, 300/dia): crie a chave em brevo.com > SMTP e API > Chaves de API e verifique o remetente.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=             # o e-mail remetente verificado no Brevo
# ou Resend (precisa de domínio próprio verificado):  RESEND_API_KEY=

# --- Lembretes por notificação (opcional) ---
# Gere com:  npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@exemplo.com

# --- Limites (opcionais; valores padrão entre parênteses) ---
LIMITE_DIARIO_VISITANTE=5       # usos por dia do chat/TACO sem login (5)
LIMITE_GERAL_MAX=400            # requisições por IP a cada 15 min (400)
LIMITE_IA_ROTULOS=20            # análises de rótulo por usuário/dia (20)
LIMITE_IA_FOTO=20               # fotos de refeição por usuário/dia (20)
LIMITE_IA_CARDAPIO=5            # cardápios por usuário/dia (5)

# --- Monitoramento (opcional) ---
SENTRY_DSN=
